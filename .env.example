# Copy this file to .env and put real values there. Never commit .env.

# Database and queue (match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://triagebot:triagebot@localhost:5432/triagebot
REDIS_URL=redis://localhost:6379/0

# GitHub App (needed from step 3; the webhook secret must not be empty)
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
# Keep the .pem file outside this repository
GITHUB_PRIVATE_KEY_PATH=

# LLM (needed from step 5)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# true: log what would be posted to GitHub, post nothing
DRY_RUN=true

# Starting values; tune after measuring
AGENT_TIMEOUT_S=120
AGENT_MAX_STEPS=10
JOB_MAX_TRIES=3

# Bearer token for the /runs endpoints
RUNS_API_TOKEN=
